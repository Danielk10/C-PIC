<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Checkbox Packihx -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_packihx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_packihx_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="12dp"
            android:text="@string/opt_packihx_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Checkbox Makebin -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_makebin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_makebin_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="12dp"
            android:text="@string/opt_makebin_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Checkbox Auto Apply -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chk_auto_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_auto_apply_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/opt_auto_apply_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="?android:attr/listDivider" />

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_packihx_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_run_packihx" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_makebin_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_run_makebin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_simulator_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_run_simulator" />

    </LinearLayout>
</ScrollView>
