<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card: Post-Processing Automation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/opt_automation_header"
                    android:textColor="@color/secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Checkbox Packihx -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_packihx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/opt_packihx_title"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    app:buttonTint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/opt_packihx_desc"
                    android:textColor="#B0BEC5"
                    android:textSize="11.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="#2E3440" />

                <!-- Checkbox Makebin -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_makebin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/opt_makebin_title"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    app:buttonTint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/opt_makebin_desc"
                    android:textColor="#B0BEC5"
                    android:textSize="11.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="#2E3440" />

                <!-- Checkbox Auto Apply -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_auto_apply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/opt_auto_apply_title"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    app:buttonTint="@color/primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="@string/opt_auto_apply_desc"
                    android:textColor="#B0BEC5"
                    android:textSize="11.5sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: On-Demand Execution -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/opt_actions_header"
                    android:textColor="@color/secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/opt_actions_desc"
                    android:textColor="#8B949E"
                    android:textSize="11.5sp" />

                <!-- Action Buttons with high-contrast theme styling -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_run_packihx_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/btn_run_packihx"
                    android:textColor="@color/primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#24292E"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_run_makebin_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_run_makebin"
                    android:textColor="@color/primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#24292E"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_run_simulator_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/btn_run_simulator"
                    android:textColor="@color/secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#24292E"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/secondary"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
